#!/bin/bash

source /etc/update-motd.d/colors.txt 2>/dev/null || true

# Разделитель
divider="--------------------------------------------------"

# Последние 4 входа с IP
last_logins=$(last -i 2>/dev/null | awk '!/wtmp|reboot|shutdown/{if ($3 ~ /^[0-9]/ || $3 ~ /^[a-f0-9]*:/) print $1, $4, $5, $6, $7, $3}' | head -n 4)

if [[ -n "$last_logins" ]]; then
    i=1
    echo -e " ${TITLE_COLOR}Last logins.........:${NC}"
    while read -r user date month day time ip; do
        printf " ${DEFAULT_COLOR}  #%d:${TEXT_COLOR} %s %s %s %s from %s${NC}\n" "$i" "$date" "$month" "$day" "$time" "$ip"
        ((i++))
    done <<< "$last_logins"
else
    echo -e " ${TITLE_COLOR}Last logins.........:${NC} ${TEXT_COLOR}No remote logins found${NC}"
fi

# Имя хоста
echo -e " ${TITLE_COLOR}Hostname............:${NC} ${TEXT_COLOR}$(hostname)${NC}"

# Внешний IP
external_ip=$(curl -s --max-time 2 ifconfig.me 2>/dev/null || echo "")
if [[ -z "$external_ip" ]]; then
    external_ip="Unavailable (check internet)"
fi
echo -e " ${TITLE_COLOR}External IP.........:${NC} ${TEXT_COLOR}$external_ip${NC}"

# Локальные интерфейсы (IPv4 + IPv6), исключая Docker
echo -e " ${TITLE_COLOR}Local Interfaces....:${NC}"
for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -vE '^(lo|docker[0-9]*|br-|veth)'); do
    ipv4=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2}' | xargs)
    ipv6=$(ip -6 addr show "$iface" 2>/dev/null | awk '/inet6 /{print $2}' | xargs)
    [[ -z "$ipv4" ]] && ipv4="No IPv4"
    [[ -z "$ipv6" ]] && ipv6="No IPv6"
    printf " ${DEFAULT_COLOR}  %-10s:${TEXT_COLOR} %s ${DEFAULT_COLOR}|${TEXT_COLOR} %s${NC}\n" "$iface" "$ipv4" "$ipv6"
done

# Loopback
lo_ipv4=$(ip -4 addr show lo 2>/dev/null | awk '/inet /{print $2}' | xargs || echo "No IPv4")
lo_ipv6=$(ip -6 addr show lo 2>/dev/null | awk '/inet6 /{print $2}' | xargs || echo "No IPv6")
printf " ${DEFAULT_COLOR}  %-10s:${TEXT_COLOR} %s ${DEFAULT_COLOR}|${TEXT_COLOR} %s${NC}\n" "lo" "$lo_ipv4" "$lo_ipv6"

echo -e "${divider}"

# Проверка SSL-сертификатов с сортировкой, CN и пометкой Expired
echo -e " ${TITLE_COLOR}SSL Certificates....:${NC}"
cert_dirs=("/etc/ssl" "/etc/letsencrypt")
cert_list=""

for dir in "${cert_dirs[@]}"; do
    if [[ -d "$dir" ]]; then
        while IFS= read -r -d '' cert; do
            end_date=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
            cn_name=$(openssl x509 -in "$cert" -noout -subject 2>/dev/null | sed -n 's/.*CN\s*=\s*\([^,/]*\).*/\1/p')
            [[ -z "$cn_name" ]] && cn_name="Unknown"
            if [[ -n "$end_date" ]]; then
                end_ts=$(date -d "$end_date" +%s 2>/dev/null)
                now_ts=$(date +%s)
                if [[ -n "$end_ts" ]]; then
                    days_left=$(( (end_ts - now_ts) / 86400 ))
                    cert_list+="${end_ts}|${cert}|${end_date}|${days_left}|${cn_name}\n"
                fi
            fi
        done < <(find "$dir" -type f \( -name "*.crt" -o -name "*.pem" \) -print0 2>/dev/null)
    fi
done

if [[ -n "$cert_list" ]]; then
    echo -e "$cert_list" | sort -n -t"|" -k1 | uniq | while IFS="|" read -r end_ts cert end_date days_left cn_name; do
        [[ -z "$end_ts" ]] && continue
        filename=$(basename "$cert")
        if (( days_left < 0 )); then
            color="${RED_COLOR}"
            status="Expired $((-days_left)) days ago"
        elif (( days_left <= 30 )); then
            color="${RED_COLOR}"
            status="$days_left days left"
        elif (( days_left <= 90 )); then
            color="${YELLOW_COLOR}"
            status="$days_left days left"
        else
            color="${TEXT_COLOR}"
            status="$days_left days left"
        fi
        printf " ${DEFAULT_COLOR}  %-22s ${DEFAULT_COLOR}[%-25s]${NC}: ${color}%-15s${NC} (${status})\n" "$filename" "$cn_name" "$end_date"
    done
else
    echo -e " ${TEXT_COLOR}No SSL certificates found${NC}"
fi

echo -e "${divider}"

#!/bin/bash

source /etc/update-motd.d/colors.txt 2>/dev/null || true

read -r USED AVAIL TOTAL <<< "$(df --output=used,avail,size -h / | tail -1 | xargs)"

USED_NUM="${USED//[a-zA-Z]/}"
USED_UNIT="${USED//[^a-zA-Z]/}"
AVAIL_NUM="${AVAIL//[a-zA-Z]/}"
AVAIL_UNIT="${AVAIL//[^a-zA-Z]/}"
TOTAL_NUM="${TOTAL//[a-zA-Z]/}"
TOTAL_UNIT="${TOTAL//[^a-zA-Z]/}"

echo -e " ${TITLE_COLOR}Disk................:${DEFAULT_COLOR} Used: ${TEXT_COLOR}${USED_NUM}${DEFAULT_COLOR} ${USED_UNIT}B | Free: ${TEXT_COLOR}${AVAIL_NUM}${DEFAULT_COLOR} ${AVAIL_UNIT}B | Total: ${TEXT_COLOR}${TOTAL_NUM}${DEFAULT_COLOR} ${TOTAL_UNIT}B${NC}"
